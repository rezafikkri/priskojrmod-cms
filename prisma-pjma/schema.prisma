// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// This schema is for priskojrmod_app database

generator client {
  provider      = "prisma-client-js"
  output        = "../prisma-pjma-db/pjma-db-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_PJMA")
  directUrl = env("DIRECT_URL_PJMA")
}

model SecretKeyLicense {
  id             Int  @id @default(autoincrement())
  product_id     String  @unique @db.Uuid
  key            String  @db.VarChar(100)
  app_name       String  @db.VarChar(50)
  created_at     Int
  regenerated_at Int?

  license_key LicenseKey[]

  @@map("secret_key_licenses")
}

model LicenseKey {
  id             String           @id @default(uuid(7)) @db.Uuid
  secret_key     SecretKeyLicense @relation(fields: [secret_key_id], references: [id])
  secret_key_id  Int
  customer_id    String           @db.Uuid
  email          String           @db.VarChar(254)
  code           String
  can_regenerate Boolean          @default(false)
  is_revoked     Boolean          @default(false)
  created_at     Int
  updated_at     Int
  regenerated_at Int?

  device_id         String? @db.VarChar(100)
  last_reset_period String? @db.VarChar(10)
  reset_count       Int     @default(0) @db.SmallInt

  @@unique([customer_id, secret_key_id])
  @@map("license_keys")
}

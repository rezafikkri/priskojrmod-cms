generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  owner
  staff

  @@map("admin_role")
}

model Admin {
  id Int @id @default(autoincrement()) @db.SmallInt

  role         AdminRole
  googleUserId String?   @unique @map("google_user_id") @db.VarChar(255)

  firstName           String @map("first_name") @db.VarChar(100)
  lastName            String @map("last_name") @db.VarChar(100)
  email               String @unique @db.VarChar(254)
  whatsappPhoneNumber String @map("whatsapp_phone_number") @db.VarChar(20)
  picture             String @db.VarChar(255)
  createdAt           Int    @map("created_at")
  updatedAt           Int    @map("updated_at")

  donationLinks DonationLink[]
  products      Product[]

  @@map("admins")
}

enum CurrencyCode {
  IDR
  USD

  @@map("currency_code")
}

model DonationLink {
  id           Int          @id @default(autoincrement())
  adminId      Int          @map("admin_id") @db.SmallInt
  currencyCode CurrencyCode @map("currency_code")
  url          String       @db.VarChar(100)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("donation_links")
}

model Owner {
  id Int @id @default(autoincrement())

  firstName    String @map("first_name") @db.VarChar(100)
  lastName     String @map("last_name") @db.VarChar(100)
  smProfileUrl String @map("sm_profile_url") @db.VarChar(255)
  picture      String @db.VarChar(255)
  createdAt    Int    @map("created_at")
  updatedAt    Int    @map("updated_at")

  products Product[]

  @@map("owners")
}

model License {
  id        Int @id @default(autoincrement())
  createdAt Int @map("created_at")
  updatedAt Int @map("updated_at")

  products     Product[]
  translations LicenseTranslation[]

  @@map("licenses")
}

model LicenseTranslation {
  id        Int      @id @default(autoincrement())
  licenseId Int      @map("license_id")
  language  Language
  name      String   @db.VarChar(100)
  content   String

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("license_translations")
}

model Category {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(100)
  slug      String @unique @db.VarChar(100)
  createdAt Int    @map("created_at")
  updatedAt Int    @map("updated_at")

  products Product[]

  @@map("categories")
}

enum PriceType {
  paid
  free

  @@map("price_type")
}

model Product {
  id         String @id @default(uuid(7)) @db.Uuid
  categoryId Int    @map("category_id")
  adminId    Int    @map("admin_id") @db.SmallInt
  ownerId    Int    @map("owner_id")
  licenseId  Int    @map("license_id")

  driveFileId String? @map("drive_file_id")
  downloadUrl String? @map("download_url")

  isPublished Boolean   @default(false) @map("is_published")
  isPinned    Boolean   @default(false) @map("is_pinned")
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(150)
  priceType   PriceType @map("price_type")
  createdAt   Int       @map("created_at")
  updatedAt   Int       @map("updated_at")

  admin    Admin    @relation(fields: [adminId], references: [id], onDelete: NoAction)
  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: NoAction)
  license  License  @relation(fields: [licenseId], references: [id], onDelete: NoAction)

  translations ProductTranslation[]
  versions     ProductVersion[]
  discount     ProductDiscount?
  coupon       ProductCoupon?
  images       ProductImage[]
  variants     ProductVariant[]
  secretKey    SecretKey?

  @@map("products")
}

model ProductTranslation {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  language    Language
  description String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_translations")
}

model ProductVersion {
  id         String @id @default(uuid(7)) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  version    String @db.VarChar(50)
  releasedAt Int    @map("released_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  translations ProductVersionTranslation[]

  @@unique([productId, version])
  @@map("product_versions")
}

model ProductVersionTranslation {
  id               String   @id @default(uuid(7)) @db.Uuid
  productVersionId String   @map("product_version_id") @db.Uuid
  language         Language
  changelog        String?

  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)

  @@map("product_version_translations")
}

model ProductDiscount {
  id        Int    @id @default(autoincrement()) @db.SmallInt
  productId String @unique @map("product_id") @db.Uuid
  discount  Int    @db.SmallInt
  expiredAt Int    @map("expired_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_discount")
}

model ProductCoupon {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @unique @map("product_id") @db.Uuid
  code      String @db.VarChar(150)
  discount  Int    @db.SmallInt
  expiredAt Int    @map("expired_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_coupon")
}

model ProductImage {
  id          String  @id @default(uuid(7)) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  url         String
  isThumbnail Boolean @map("is_thumbnail")
  width       Int     @db.SmallInt
  height      Int     @db.SmallInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id                 String  @id @default(uuid(7)) @db.Uuid
  productId          String  @map("product_id") @db.Uuid
  name               String  @db.VarChar(100)
  downloadUrl        String? @map("download_url")
  fileAccessPassword String? @map("file_access_password") @db.VarChar(100)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices  ProductPrice[]

  @@map("product_variants")
}

model ProductPrice {
  id           String       @id @default(uuid(7)) @db.Uuid
  variantId    String       @map("variant_id") @db.Uuid
  currencyCode CurrencyCode @map("currency_code")
  price        Decimal      @db.Decimal(10, 2)

  variant            ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transcationDetails TransactionDetail[]

  @@map("product_prices")
}

enum Language {
  id
  en

  @@map("language")
}

model TermsOfService {
  id        Int @id @default(autoincrement()) @db.SmallInt
  createdAt Int @map("created_at")
  updatedAt Int @map("updated_at")

  translations TermsOfServiceTranslation[]

  @@map("terms_of_service")
}

model TermsOfServiceTranslation {
  id               Int      @id @default(autoincrement()) @db.SmallInt
  termsOfServiceId Int      @map("terms_of_service_id") @db.SmallInt
  language         Language
  content          String

  termsOfService TermsOfService @relation(fields: [termsOfServiceId], references: [id], onDelete: Cascade)

  @@map("terms_of_service_translations")
}

model PrivacyPolicy {
  id        Int @id @default(autoincrement()) @db.SmallInt
  createdAt Int @map("created_at")
  updatedAt Int @map("updated_at")

  translations PrivacyPolicyTranslation[]

  @@map("privacy_policy")
}

model PrivacyPolicyTranslation {
  id              Int      @id @default(autoincrement()) @db.SmallInt
  privacyPolicyId Int      @map("privacy_policy_id") @db.SmallInt
  language        Language
  content         String

  privacyPolicy PrivacyPolicy @relation(fields: [privacyPolicyId], references: [id], onDelete: Cascade)

  @@map("privacy_policy_translations")
}

model AboutUs {
  id              Int    @id @default(autoincrement()) @db.SmallInt
  supportEmail    String @map("support_email") @db.VarChar(254)
  supportWhatsapp String @map("support_whatsapp") @db.VarChar(20)

  translations AboutUsTranslation[]

  @@map("about_us")
}

model AboutUsTranslation {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  aboutUsId   Int      @map("about_us_id") @db.SmallInt
  language    Language
  content     String
  officeHours String   @map("office_hours") @db.VarChar(255)

  aboutUs AboutUs @relation(fields: [aboutUsId], references: [id], onDelete: Cascade)

  @@map("about_us_translations")
}

model Faq {
  id        Int @id @default(autoincrement())
  createdAt Int @map("created_at")
  updatedAt Int @map("updated_at")

  translations FaqTranslation[]

  @@map("faqs")
}

model FaqTranslation {
  id       Int      @id @default(autoincrement())
  faqId    Int      @map("faq_id")
  language Language
  title    String   @db.VarChar(150)
  content  String

  faq Faq @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@map("faq_translations")
}

model Customer {
  id           String  @id @default(uuid(7)) @db.Uuid
  googleUserId String? @unique @map("google_user_id") @db.VarChar(255)
  isBanned     Boolean @default(false) @map("is_banned")
  firstName    String  @map("first_name") @db.VarChar(100)
  lastName     String  @map("last_name") @db.VarChar(100)
  email        String  @unique @db.VarChar(254)
  phoneNumber  String? @map("phone_number") @db.VarChar(20)
  picture      String? @db.VarChar(255)
  lastActive   Int?    @map("last_active")
  createdAt    Int     @map("created_at")
  updatedAt    Int     @map("updated_at")

  transactions Transaction[]
  licenseKeys  LicenseKey[]

  @@map("customers")
}

enum TransactionStatus {
  pending
  paid
  cancelled
  refund

  @@map("transaction_status")
}

enum ShareMethod {
  download_link
  drive_share
  manual_required

  @@map("share_method")
}

model Transaction {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique @db.VarChar(32)
  customer_id String? @db.Uuid

  admin_id    Int    @db.SmallInt // only for reference
  admin_email String @db.VarChar(254)

  status        TransactionStatus
  created_at    Int
  updated_at    Int
  currency_code CurrencyCode
  total_amount  Decimal           @db.Decimal(10, 2)

  customer_name         String  @db.VarChar(200)
  customer_email        String  @db.VarChar(254)
  customer_phone_number String? @db.VarChar(20)

  customer Customer?           @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  details  TransactionDetail[]
  invoices Invoice[]

  @@map("transactions")
}

model Feedback {
  id        String  @id @default(uuid(7)) @db.Uuid
  isRead    Boolean @default(false) @map("is_read")
  name      String? @db.VarChar(100)
  email     String? @db.VarChar(254)
  message   String
  createdAt Int     @unique @map("created_at")

  @@map("feedbacks")
}

model Testimonial {
  id           Int    @id @default(autoincrement()) @db.SmallInt
  picture      String @db.VarChar(255)
  name         String @db.VarChar(100)
  smProfileUrl String @map("sm_profile_url") @db.VarChar(100)
  createdAt    Int    @map("created_at")
  updatedAt    Int    @map("updated_at")

  translations TestimonialTranslation[]

  @@map("testimonials")
}

model TestimonialTranslation {
  id            Int      @id @default(autoincrement()) @db.SmallInt
  testimonialId Int      @map("testimonial_id") @db.SmallInt
  language      Language
  message       String

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@map("testimonial_translations")
}

enum InvoiceStatus {
  active
  void

  @@map("invoice_status")
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  transaction_id String        @db.Uuid
  invoice_number String        @unique @db.VarChar(32)
  status         InvoiceStatus
  issued_at      Int
  voided_at      Int?

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model TransactionDetail {
  id                String  @id @default(uuid(7)) @db.Uuid
  transaction_id    String  @db.Uuid
  product_id        String  @db.Uuid
  product_price_id  String? @db.Uuid
  product_coupon_id String? @db.Uuid
  quantity          Int     @db.SmallInt

  product_name          String  @db.VarChar(150)
  product_version       String  @db.VarChar(50)
  product_drive_file_id String?
  product_download_url  String?

  product_variant              String  @db.VarChar(100)
  variant_download_url         String?
  variant_file_access_password String? @db.VarChar(100)

  product_currency_code   CurrencyCode
  product_price           Decimal      @db.Decimal(10, 2)
  product_discount        Int?         @db.SmallInt
  product_coupon_code     String?      @db.VarChar(150)
  product_coupon_discount Int?         @db.SmallInt

  drive_permission_id String?      @db.VarChar(100)
  share_method        ShareMethod?
  shared_at           Int?

  transaction Transaction   @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  price       ProductPrice? @relation(fields: [product_price_id], references: [id], onDelete: SetNull)

  @@map("transaction_details")
}

// Secret keys and license keys
model SecretKey {
  id             Int     @id @default(autoincrement())
  product_id     String? @unique @db.Uuid
  key            String  @db.VarChar(100)
  created_at     Int
  regenerated_at Int?

  product Product? @relation(fields: [product_id], references: [id], onDelete: Cascade)

  licenseKey LicenseKey[]

  @@map("secret_keys")
}

model LicenseKey {
  id             String  @id @default(uuid(7)) @db.Uuid
  secret_key_id  Int
  customer_id    String  @db.Uuid
  code           String
  can_regenerate Boolean @default(false)
  is_revoked     Boolean @default(false)
  created_at     Int
  updated_at     Int
  regenerated_at Int?

  device_id         String? @db.VarChar(100)
  last_reset_period String? @db.VarChar(10)
  reset_count       Int     @default(0) @db.SmallInt

  secretKey SecretKey @relation(fields: [secret_key_id], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, secret_key_id])
  @@map("license_keys")
}
